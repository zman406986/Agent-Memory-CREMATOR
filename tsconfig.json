{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": ".",
    "types": [
      "node"
    ],
    "paths": {
      "@cremator/core": [
        "./packages/core/src/index.ts"
      ],
      "cremator-dsh": [
        "./src/index.ts"
      ],
      "cremator-opencode": [
        "./packages/adapters/opencode/src/index.ts"
      ]
    }
  },
  "include": [
    "examples/**/*.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "packages/core/src/**/*.ts",
    "packages/core/test/**/*.ts",
    "packages/adapters/opencode/src/**/*.ts",
    "packages/adapters/opencode/test/**/*.ts"
  ]
}
