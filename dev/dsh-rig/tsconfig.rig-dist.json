{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": "../..",
    "outDir": "../../scratchpad/dsh-rig/dist",
    "types": ["node"],
    "paths": {
      "@cremator/core": ["../../packages/core/src/index.ts"],
