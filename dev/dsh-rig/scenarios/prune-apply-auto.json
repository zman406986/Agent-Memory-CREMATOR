      ],
      "l2RemovalCounts": [
        {
          "keeplines": 0,
          "forgetall": 0,
          "forgetlines": 0
        },
        {
          "keeplines": 0,
          "forgetall": 1,
          "forgetlines": 0
        },
        {
          "keeplines": 0,
          "forgetall": 0,
          "forgetlines": 0
        }
      ],
      "refusedTotal": 0,
      "rejectedCount": 0,
      "keeplinesSummaries": 0,
      "thresholds": 3,
      "threshold": 20000,
      "crossingsPerLaunch": [
