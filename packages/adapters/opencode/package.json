{
  "name": "cremator-opencode",
  "version": "0.1.2",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "description": "CREMATOR adapter for the OpenCode 2.4.0 harness. Thin seam mapping, no policy.",
  "keywords": [
    "context-management",
    "context-window",
    "llm-agents",
    "coding-agents",
    "ai-agent",
    "compaction",
    "opencode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zman406986/Agent-Memory-CREMATOR.git",
    "directory": "packages/adapters/opencode"
  },
  "homepage": "https://github.com/zman406986/Agent-Memory-CREMATOR#readme",
  "bugs": {
    "url": "https://github.com/zman406986/Agent-Memory-CREMATOR/issues"
  },
  "author": {
    "name": "zman406986",
    "url": "https://github.com/zman406986"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./tui": {
      "default": "./ui/tui.js"
    },
    "./gui-experimental": {
      "default": "./ui/gui-experimental.cjs"
    }
  },
  "files": [
    "dist",
    "ui",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0 <23.0.0 || >=23.4.0"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@cremator/core": "^0.1.0"
  },
  "devDependencies": {
    "@opencode/ai": "2.4.0",
    "@opencode/plugin": "2.4.0",
    "@opencode/schema": "2.4.0"
  }
}
