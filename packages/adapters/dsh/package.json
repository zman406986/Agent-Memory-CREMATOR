{
  "name": "cremator-dsh",
  "version": "0.1.2",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "description": "CREMATOR adapter for the dsh harness. Thin seam mapping, no policy.",
  "keywords": [
    "context-management",
    "context-window",
    "llm-agents",
    "coding-agents",
    "ai-agent",
    "compaction",
    "dsh",
    "deepseek-harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zman406986/Agent-Memory-CREMATOR.git",
    "directory": "packages/adapters/dsh"
  },
  "homepage": "https://github.com/zman406986/Agent-Memory-CREMATOR#readme",
  "bugs": {
    "url": "https://github.com/zman406986/Agent-Memory-CREMATOR/issues"
  },
  "author": {
    "name": "zman406986",
    "url": "https://github.com/zman406986"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0 <23.0.0 || >=23.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.0.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@cremator/core": "^0.1.0"
  }
}
