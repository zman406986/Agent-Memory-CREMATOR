{
  "model": "deepseek-flash",
  "stream": true,
  "max_tokens": 32000,
  "system": "You are a coding agent operating on a local repository. Report results as short lines.",
  "tools": [
    {
      "name": "read_file",
      "description": "Read one file and return its bytes.",
      "input_schema": {
        "type": "object",
        "properties": { "path": { "type": "string" } },
        "required": ["path"]
      }
    },
    {
      "name": "run_shell",
      "description": "Run one shell command in the workspace root.",
      "input_schema": {
        "type": "object",
        "properties": {
          "command": { "type": "string" },
          "timeout_ms": { "type": "number" }
        },
        "required": ["command"]
      }
    },
    {
      "name": "search_files",
      "description": "Search the workspace for a literal string.",
      "input_schema": {
        "type": "object",
        "properties": { "query": { "type": "string" } },
        "required": ["query"]
      }
    }
  ],
  "messages": [
    {
      "role": "user",
      "content": [
        { "type": "text", "text": "Inspect the example module.\n" },
        { "type": "text", "text": "Then report one fact." }
      ]
    },
    {
      "role": "assistant",
      "content": [
        {
          "type": "tool_use",
          "id": "call_0",
          "name": "read_file",
          "input": { "path": "src/example.ts" }
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "tool_use_id": "call_0",
          "is_error": false,
          "content": [{ "type": "text", "text": "export const answer = 42;\n" }]
        }
      ]
    },
    {
      "role": "assistant",
      "content": [{ "type": "text", "text": "The module exports one constant." }]
    },
    {
      "role": "user",
      "content": [{ "type": "text", "text": "Keep the report under five words." }]
    }
  ]
}
